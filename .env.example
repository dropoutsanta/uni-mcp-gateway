# ── Required ──────────────────────────────────────────────────────────────────

# Admin API key — used to bootstrap the first admin key on startup
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=your-secret-admin-token-here

# Public base URL of this gateway (used for webhook URLs, media serving, etc.)
MCP_BASE_URL=http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite database path (auto-created on first run)
GATEWAY_DB_PATH=/data/gateway.db

# ── Optional ──────────────────────────────────────────────────────────────────

# Admin key identifier (default: "admin")
# ADMIN_KEY_ID=admin

# Server port (default: 8080)
# PORT=8080

# ── WhatsApp Plugin (optional) ────────────────────────────────────────────────

# URL of the Go WhatsApp bridge process
# WHATSAPP_BRIDGE_URL=http://localhost:7481

# ── Plugin Credentials ───────────────────────────────────────────────────────
# Plugin credentials are stored in the database and managed via admin tools.
# Set them after first run using:
#   gateway_set_credentials(key_id="admin", plugin="gmail", credentials={
#     "client_id": "...",
#     "client_secret": "...",
#     "refresh_token": "..."
#   })

# ── Plugin loading (optional) ─────────────────────────────────────────────────

# Comma-separated plugin names to load; unset loads every plugin
# PLUGINS_ALLOWLIST=gmail,slack,linear

# ── LLM proxy (optional) ──────────────────────────────────────────────────────
# Wake-aware /llm proxy in front of LiteLLM that starts/stops RunPod GPU pods.
# See litellm-config.example.yaml and llm-pods.example.json.

# RUNPOD_API_KEY=
# LLM_PODS_CONFIG=/app/llm-pods.json
# POD_STATE_PATH=/data/pod_state.json
# LITELLM_MASTER_KEY=
# LLM_API_KEY=            # key llama-server / LiteLLM use to talk to the pod
# RUNPOD_SSH_PUBKEY=      # optional, seeded into auto-respawned pods

# ── Slack slash command (optional) ────────────────────────────────────────────
# SLACK_APP_TOKEN=
# SLASH_ALLOWED_CHANNELS=C0123456789,C0987654321
# SLASH_CRED_KEY_ID=admin
